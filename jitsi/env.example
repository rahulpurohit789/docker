# Jitsi Environment Configuration
# Copy this file to .env and configure it:
#   cp env.example .env
#   nano .env

# Set to "development" for local testing or "production" for EC2 deployment
ENVIRONMENT=development

# Development settings (used when ENVIRONMENT=development)
DEV_JITSI_DOMAIN=localhost
DEV_DOCKER_HOST_ADDRESS=localhost

# Production settings (used when ENVIRONMENT=production)
PROD_JITSI_DOMAIN=35.154.130.125
PROD_DOCKER_HOST_ADDRESS=35.154.130.125

# JWT Configuration
JWT_APP_ID=collabsphere
JWT_APP_SECRET=dev-jitsi-secret-change-in-production

# Auto-set based on ENVIRONMENT (don't edit manually)
JITSI_DOMAIN=${JITSI_DOMAIN:-localhost}
DOCKER_HOST_ADDRESS=${DOCKER_HOST_ADDRESS:-localhost}

# Port Configuration
HTTP_PORT=80
HTTPS_PORT=443
JVB_PORT=10000
JVB_TCP_PORT=4443

# Optional: Let's Encrypt (only for production with domain name)
ENABLE_LETSENCRYPT=0
LETSENCRYPT_EMAIL=

# Generated passwords (will be created by generate-passwords.sh)
# JVB_AUTH_PASSWORD=
# JICOFO_AUTH_PASSWORD=
# JIBRI_RECORDER_PASSWORD=
# JIBRI_XMPP_PASSWORD=

# Optional: JWT ASAP Keyserver (for advanced JWT setup)
JWT_ASAP_KEYSERVER=

